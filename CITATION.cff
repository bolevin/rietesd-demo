  - family-names: Levin
    given-names: "A. A."
keywords:
  - Rietveld refinement
  - powder diffraction
  - estimated standard deviation
  - serial correlation
  - Durbin-Watson statistic
preferred-citation:
  type: report
  title: "Program RietESD for correction of estimated standard deviations obtained in Rietveld-refinement programs"
  authors:
